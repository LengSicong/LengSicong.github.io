---
import Base from '@/layouts/Base.astro';
import NewsTimeline from '@/components/NewsTimeline.astro';
import PublicationCard from '@/components/PublicationCard.astro';
import { site } from '@/data/site';
import { publications, scholarUrl } from '@/data/publications';
import { work } from '@/data/experience';
import { renderInline } from '@/lib/markdown-lite';

const featuredPubs = publications.filter((p) => p.featured);
const bioParagraphs = site.bio.map((p) => renderInline(p));
---

<Base>
  <main class="mx-auto max-w-column px-6 sm:px-8 pt-16 sm:pt-24 pb-24">

    <!-- Hero -->
    <header class="mb-24 sm:mb-32 sm:grid sm:grid-cols-[1fr_auto] sm:gap-10 sm:items-start">
      <img
        src="/images/profile.jpg"
        alt={`Portrait of ${site.name}`}
        width="128"
        height="128"
        loading="eager"
        decoding="async"
        class="mb-8 sm:mb-0 sm:order-2 h-24 w-24 sm:h-32 sm:w-32 rounded-lg object-cover"
      />

      <div>
        <h1 class="text-4xl sm:text-5xl leading-[1.05] tracking-tight">
          Sicong Leng
          <span class="text-mist text-[0.5em] align-baseline ml-1">冷思聪</span>
        </h1>

        <p class="mt-6 text-xl sm:text-2xl leading-snug text-charcoal">
          {site.tagline.replace('\n', ' ')}
        </p>

        <p class="mt-5 text-mist">
          {site.affiliation} · {site.location}
        </p>

        <p class="mt-6">
          <a href={site.socials.github} target="_blank" rel="noopener noreferrer">github</a>
          <span class="text-mist mx-1.5">·</span>
          <a href={site.socials.scholar} target="_blank" rel="noopener noreferrer">google scholar</a>
          <span class="text-mist mx-1.5">·</span>
          <a href={site.socials.twitter} target="_blank" rel="noopener noreferrer">twitter</a>
          <span class="text-mist mx-1.5">·</span>
          <a href={`mailto:${site.socials.email}`}>email</a>
        </p>
      </div>
    </header>

    <!-- Bio -->
    <section class="space-y-4 mb-20 sm:mb-24">
      {bioParagraphs.map((html) => <p set:html={html} />)}
    </section>

    <!-- News -->
    <section class="mb-20 sm:mb-24">
      <h2 class="text-xl mb-6">News</h2>
      <NewsTimeline initialCount={8} />
    </section>

    <!-- Selected Publications -->
    <section class="mb-20 sm:mb-24">
      <h2 class="text-xl mb-6">Selected publications</h2>
      <div class="space-y-7">
        {featuredPubs.map((pub) => <PublicationCard pub={pub} />)}
      </div>
      <p class="mt-8">
        <a href="/publications/">All publications →</a>
        <span class="text-mist mx-1.5">·</span>
        <a href={scholarUrl} target="_blank" rel="noopener noreferrer">Google Scholar</a>
      </p>
    </section>

    <!-- Experience -->
    <section class="mb-20 sm:mb-24">
      <h2 class="text-xl mb-6">Experience</h2>
      <div class="space-y-7">
        {
          work.map((w) => (
            <div>
              <p class="text-charcoal">
                {w.role}, {w.orgUrl ? <a href={w.orgUrl} target="_blank" rel="noopener noreferrer">{w.org}</a> : w.org}
              </p>
              <p class="text-mist text-[15px] tabular-nums">{w.period}</p>
              {w.description && <p class="mt-1.5">{w.description}</p>}
              {w.supervisor && (
                <p class="mt-1 text-[15px] text-mist">
                  Supervisor:{' '}
                  {w.supervisorUrl ? (
                    <a href={w.supervisorUrl} target="_blank" rel="noopener noreferrer">{w.supervisor}</a>
                  ) : (
                    w.supervisor
                  )}
                </p>
              )}
            </div>
          ))
        }
      </div>
    </section>

    <!-- Off the clock -->
    <section class="mb-20 sm:mb-24">
      <h2 class="text-xl mb-6">Off the clock</h2>
      <p>
        {site.hobbies.map((h, i) => (
          <>
            {i > 0 && <span class="text-mist mx-1.5">·</span>}
            <span class="mr-1.5">{h.emoji}</span>{h.name.toLowerCase()}
          </>
        ))}.
      </p>
    </section>

    <!-- Closing quote -->
    <aside class="mt-32 pt-8 border-t border-border">
      <blockquote class="italic text-mist">
        “{site.mission.quote}”
        <span class="not-italic"> — {site.mission.attribution}</span>
      </blockquote>
    </aside>

  </main>
</Base>
