---
import Base from '@/layouts/Base.astro';
import Hero from '@/components/Hero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import BioBlock from '@/components/BioBlock.astro';
import NewsTimeline from '@/components/NewsTimeline.astro';
import PublicationCard from '@/components/PublicationCard.astro';
import { site } from '@/data/site';
import { publications, scholarUrl } from '@/data/publications';
import { work } from '@/data/experience';

const featuredPubs = publications.filter((p) => p.featured);
---

<Base showNav={false}>
  <Hero />

  <!-- Inline nav after hero so it doesn't compete with the landing -->
  <div class="sticky top-0 z-30 backdrop-blur-md bg-ivory/80 border-b border-border/60">
    <div class="mx-auto max-w-wide px-6 sm:px-8 md:px-12 h-14 flex items-center justify-between">
      <a href="#top" class="font-serif text-lg tracking-tight text-charcoal hover:text-sienna transition-colors">
        SL<span class="text-clay">.</span>
      </a>
      <ul class="flex items-center gap-5 sm:gap-7 text-sm font-mono uppercase tracking-wider text-graphite">
        <li><a href="#mission" class="hover:text-clay transition-colors">Mission</a></li>
        <li><a href="#about" class="hover:text-clay transition-colors">About</a></li>
        <li><a href="#news" class="hover:text-clay transition-colors">News</a></li>
        <li><a href="#publications" class="hover:text-clay transition-colors">Pubs</a></li>
        <li><a href="/publications/" class="hover:text-clay transition-colors">All</a></li>
      </ul>
    </div>
  </div>

  <!-- Mission / North Star -->
  <section id="mission" class="relative bg-bone/60 border-b border-border/60 overflow-hidden">
    <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 h-[420px] w-[680px] rounded-full bg-clay/10 blur-3xl"></div>
    </div>
    <div class="mx-auto max-w-wide px-6 sm:px-8 md:px-12 py-24 sm:py-32">
      <SectionHeading
        eyebrow="North Star"
        title="Why I'm here"
        align="center"
        class="mb-14"
      />

      <figure class="max-w-reading mx-auto text-center">
        <svg
          class="mx-auto h-8 w-8 text-clay/40 mb-6"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M7.17 4A5.17 5.17 0 002 9.17v8.66A1.17 1.17 0 003.17 19h7.66A1.17 1.17 0 0012 17.83V9.17A5.17 5.17 0 006.83 4H7.17zm10 0A5.17 5.17 0 0012 9.17v8.66A1.17 1.17 0 0013.17 19h7.66A1.17 1.17 0 0022 17.83V9.17A5.17 5.17 0 0016.83 4h.34z" />
        </svg>
        <blockquote
          class="font-serif italic text-2xl sm:text-3xl md:text-[2.25rem] leading-snug text-charcoal"
        >
          {site.mission.quote}
        </blockquote>
        <figcaption class="mt-8 font-mono text-xs uppercase tracking-[0.25em] text-clay">
          — {site.mission.attribution}
        </figcaption>
      </figure>

      <p
        class="mt-12 max-w-reading mx-auto text-center text-graphite text-base sm:text-lg leading-relaxed"
      >
        {site.mission.coda}
      </p>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="mx-auto max-w-wide px-6 sm:px-8 md:px-12 py-24 sm:py-28">
    <SectionHeading eyebrow="About" title="A bit about me" class="mb-12" />
    <BioBlock />
  </section>

  <!-- News -->
  <section id="news" class="bg-bone/40 border-y border-border/60">
    <div class="mx-auto max-w-wide px-6 sm:px-8 md:px-12 py-24 sm:py-28">
      <SectionHeading eyebrow="News" title="What's happening" class="mb-12" />
      <NewsTimeline initialCount={8} />
    </div>
  </section>

  <!-- Selected Publications -->
  <section id="publications" class="mx-auto max-w-wide px-6 sm:px-8 md:px-12 py-24 sm:py-28">
    <SectionHeading
      eyebrow="Research"
      title="Selected publications"
      class="mb-12"
    />

    <div class="space-y-5">
      {featuredPubs.map((pub) => <PublicationCard pub={pub} />)}
    </div>

    <div class="mt-10 flex flex-wrap gap-x-6 gap-y-2 text-sm">
      <a
        href="/publications/"
        class="font-mono text-xs uppercase tracking-[0.2em] text-clay hover:text-sienna transition-colors"
      >
        See all publications →
      </a>
      <a
        href={scholarUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="font-mono text-xs uppercase tracking-[0.2em] text-mist hover:text-clay transition-colors"
      >
        Google Scholar ↗
      </a>
    </div>
  </section>

  <!-- Experience -->
  <section id="experience" class="bg-bone/40 border-y border-border/60">
    <div class="mx-auto max-w-wide px-6 sm:px-8 md:px-12 py-24 sm:py-28">
      <SectionHeading eyebrow="Experience" title="Where I've worked" class="mb-12" />
      <ul class="space-y-6">
        {
          work.map((w) => (
            <li class="rounded-xl border border-border bg-ivory p-5 sm:p-6">
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <h3 class="font-serif text-xl text-charcoal">{w.role}</h3>
                <span class="font-mono text-xs text-mist">{w.period}</span>
              </div>
              <p class="mt-1 text-graphite">
                {w.orgUrl ? (
                  <a href={w.orgUrl} class="link-clay" target="_blank" rel="noopener noreferrer">
                    {w.org}
                  </a>
                ) : (
                  w.org
                )}
              </p>
              {w.description && <p class="mt-2 text-mist">{w.description}</p>}
              {w.supervisor && (
                <p class="mt-2 text-sm text-mist">
                  Supervisor:{' '}
                  {w.supervisorUrl ? (
                    <a href={w.supervisorUrl} class="link-clay" target="_blank" rel="noopener noreferrer">
                      {w.supervisor}
                    </a>
                  ) : (
                    w.supervisor
                  )}
                </p>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Hobbies -->
  <section id="hobbies" class="mx-auto max-w-wide px-6 sm:px-8 md:px-12 py-24 sm:py-28">
    <SectionHeading
      eyebrow="Off the clock"
      title="When I'm not working"
      class="mb-12"
    />
    <ul class="grid sm:grid-cols-3 gap-4">
      {
        site.hobbies.map((h) => (
          <li class="rounded-xl border border-border bg-bone/40 p-5 sm:p-6 transition-colors hover:border-clay/40 hover:-translate-y-0.5">
            <div class="text-3xl mb-3 leading-none" aria-hidden="true">{h.emoji}</div>
            <h3 class="font-serif text-xl text-charcoal">{h.name}</h3>
            <p class="mt-2 text-sm text-mist leading-relaxed">{h.detail}</p>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
