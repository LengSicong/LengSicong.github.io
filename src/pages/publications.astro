---
import Base from '@/layouts/Base.astro';
import PublicationCard from '@/components/PublicationCard.astro';
import { publications, scholarUrl } from '@/data/publications';

const byYear = new Map<number, typeof publications>();
for (const pub of publications) {
  if (!byYear.has(pub.year)) byYear.set(pub.year, []);
  byYear.get(pub.year)!.push(pub);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
---

<Base title="Publications" description="Publications by Sicong Leng.">
  <main class="mx-auto max-w-column px-6 sm:px-8 pt-16 sm:pt-20 pb-24">
    <p class="mb-10">
      <a href="/">← Home</a>
    </p>

    <h1 class="text-3xl sm:text-4xl tracking-tight mb-3">Publications</h1>
    <p class="text-mist mb-12">
      For the most up-to-date list, see <a href={scholarUrl} target="_blank" rel="noopener noreferrer">Google Scholar</a>.
    </p>

    <div class="space-y-14">
      {
        years.map((year) => (
          <section>
            <div class="h-px w-10 bg-clay mx-auto mb-6" aria-hidden="true"></div>
            <h2 class="text-2xl font-semibold mb-7 tabular-nums">{year}</h2>
            <div class="space-y-7">
              {byYear.get(year)!.map((pub) => <PublicationCard pub={pub} />)}
            </div>
          </section>
        ))
      }
    </div>
  </main>
</Base>
