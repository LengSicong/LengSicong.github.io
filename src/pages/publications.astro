---
import Base from "@/layouts/Base.astro";
import PublicationCard from "@/components/PublicationCard.astro";
import { publications, scholarUrl } from "@/data/publications";
import { withBase } from "@/lib/paths";
const years = [...new Set(publications.map((p) => p.year))].sort(
  (a, b) => b - a,
);
---

<Base
  title="Publications"
  description="Selected publications and research projects by Sicong Leng."
>
  <main id="main" class="page-width archive-page">
    <a class="text-link" href={withBase()}>← Back home</a><p class="eyebrow">
      Research archive
    </p><h1>Publications</h1>
    <p class="archive-intro">
      A selection of papers and open projects. For the complete and most
      up-to-date list, see <a
        href={scholarUrl}
        target="_blank"
        rel="noopener noreferrer">Google Scholar ↗</a
      >.
    </p>
    {
      years.map((year) => (
        <section class="archive-year">
          <>
            <h2>{year}</h2>
            <div>
              {publications
                .filter((p) => p.year === year)
                .map((pub) => (
                  <PublicationCard pub={pub} />
                ))}
            </div>
          </>
        </section>
      ))
    }
  </main>
</Base>
