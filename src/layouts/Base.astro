---
import "@/styles/global.css";
import { site } from "@/data/site";
import { withBase } from "@/lib/paths";
import Footer from "@/components/Footer.astro";
interface Props {
  title?: string;
  description?: string;
}
const { title = site.title, description = site.description } = Astro.props;
const pageTitle = title === site.title ? site.title : `${title} · ${site.name}`;
const pagePath =
  Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ""), "") ||
  "/";
const canonical = new URL(pagePath, site.url).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <title>{pageTitle}</title><meta name="description" content={description} />
    <link rel="canonical" href={canonical} /><link
      rel="icon"
      type="image/svg+xml"
      href={withBase("favicon.svg")}
    />
    <meta name="theme-color" content="#f5f2eb" />
    <meta property="og:type" content="website" /><meta
      property="og:title"
      content={pageTitle}
    />
    <meta property="og:description" content={description} /><meta
      property="og:url"
      content={canonical}
    />
    <meta
      property="og:image"
      content={new URL("/images/profile.jpg", site.url).toString()}
    />
    <meta name="twitter:card" content="summary" />
    <link rel="preconnect" href="https://fonts.googleapis.com" /><link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;450;500;550;600;650;700;750&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <nav class="page-width nav-inner" aria-label="Main navigation">
        <a class="wordmark" href={withBase()} aria-label="Sicong Leng, home"
          >sl<span aria-hidden="true">.</span></a
        >
        <div class="nav-links">
          <a href={`${withBase()}#research`}>Research</a><a
            href={`${withBase()}#news`}>Updates</a
          ><a href={`${withBase()}#experience`}>About</a><a
            class="nav-contact"
            href={`${withBase()}#contact`}
            >Contact <span aria-hidden="true">↗</span></a>
        </div>
      </nav>
    </header>
    <slot /><Footer />
  </body>
</html>
