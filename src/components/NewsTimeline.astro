---
import { news } from "@/data/news";
import { renderInline } from "@/lib/markdown-lite";
interface Props {
  initialCount?: number;
}
const { initialCount = 4 } = Astro.props;
const fmt = (v: string) =>
  new Date(`${v}-01T12:00:00Z`).toLocaleDateString("en-US", {
    month: "short",
    year: "numeric",
    timeZone: "UTC",
  });
---

<div class="news-timeline">
  <ol class="news-list">
    {
      news.slice(0, initialCount).map((item) => (
        <li>
          <>
            <time datetime={item.date}>{fmt(item.date)}</time>
            <p set:html={renderInline(item.body)} />
          </>
        </li>
      ))
    }
  </ol>
  {
    news.length > initialCount && (
      <details class="news-archive">
        <>
          <summary>
            More updates <span aria-hidden="true">+</span>
          </summary>
          <ol class="news-list">
            {news.slice(initialCount).map((item) => (
              <li>
                <time datetime={item.date}>{fmt(item.date)}</time>
                <p set:html={renderInline(item.body)} />
              </li>
            ))}
          </ol>
        </>
      </details>
    )
  }
</div>
