---
import { news } from '@/data/news';
import { renderInline } from '@/lib/markdown-lite';

interface Props {
  initialCount?: number;
}

const { initialCount = 8 } = Astro.props;

function fmt(d: string): string {
  const [y, m] = d.split('-');
  const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  return `${months[Number(m) - 1] ?? m} ${y}`;
}

const items = news.map((n) => ({ date: fmt(n.date), html: renderInline(n.body) }));
const visible = items.slice(0, initialCount);
const hidden = items.slice(initialCount);
---

<ol class="space-y-3">
  {
    visible.map((item) => (
      <li>
        <span class="text-mist tabular-nums">{item.date}</span>
        <span class="mx-1 text-mist">·</span>
        <span set:html={item.html} />
      </li>
    ))
  }

  {
    hidden.length > 0 && (
      <>
        <li id="news-rest" hidden class="space-y-3 !mt-3">
          {hidden.map((item) => (
            <div>
              <span class="text-mist tabular-nums">{item.date}</span>
              <span class="mx-1 text-mist">·</span>
              <span set:html={item.html} />
            </div>
          ))}
        </li>
        <li class="!mt-6">
          <button
            type="button"
            id="news-toggle"
            data-more={`Show ${hidden.length} more`}
            data-less="Show less"
            class="text-clay"
          >
            Show {hidden.length} more
          </button>
        </li>
      </>
    )
  }
</ol>

<script is:inline>
  (() => {
    const btn = document.getElementById('news-toggle');
    const rest = document.getElementById('news-rest');
    if (!btn || !rest) return;
    let open = false;
    btn.addEventListener('click', () => {
      open = !open;
      rest.hidden = !open;
      btn.textContent = open ? btn.dataset.less : btn.dataset.more;
    });
  })();
</script>
