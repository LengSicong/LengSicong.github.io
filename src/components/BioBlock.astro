---
import { site } from '@/data/site';
import { renderInline } from '@/lib/markdown-lite';

const paragraphs = site.bio.map((p) => renderInline(p));
---

<div class="grid gap-10 md:grid-cols-[1fr_180px] md:items-start">
  <div class="space-y-5">
    <div class="space-y-4 text-graphite leading-relaxed text-base sm:text-lg [&_a]:link-clay [&_strong]:text-charcoal">
      {paragraphs.map((html) => <p set:html={html} />)}
    </div>

    <ul class="flex flex-wrap gap-2 pt-1">
      {site.interests.map((tag) => <li class="pill-sand">{tag}</li>)}
    </ul>
  </div>

  <figure class="md:pt-2 max-w-[180px] mx-auto md:mx-0">
    <div
      class="relative aspect-square overflow-hidden rounded-2xl ring-1 ring-border bg-bone"
    >
      <img
        src="/images/profile.jpg"
        alt={`Portrait of ${site.name}`}
        loading="eager"
        decoding="async"
        class="h-full w-full object-cover"
      />
    </div>
    <figcaption class="mt-3 text-center md:text-left text-xs text-mist font-mono">
      {site.name} · {site.location}
    </figcaption>
  </figure>
</div>
