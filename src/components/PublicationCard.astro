---
import type { Publication } from "@/data/publications";
import { renderInline } from "@/lib/markdown-lite";
interface Props {
  pub: Publication;
  compact?: boolean;
}
const { pub, compact = false } = Astro.props;
const href = pub.links?.paper ?? pub.links?.project ?? pub.links?.code;
---

<article class:list={["publication", { "publication-compact": compact }]}>
  <p class="publication-venue">
    {pub.venue}
    {pub.year}{pub.badges?.length ? ` · ${pub.badges.join(" · ")}` : ""}
  </p>
  <h3>
    {
      href ? (
        <a href={href} target="_blank" rel="noopener noreferrer">
          {pub.title}
        </a>
      ) : (
        pub.title
      )
    }
  </h3>
  {
    !compact && (
      <p class="publication-authors" set:html={renderInline(pub.authors)} />
    )
  }
  <div class="publication-links">
    {
      Object.entries(pub.links ?? {}).map(([label, url]) => (
        <a href={url} target="_blank" rel="noopener noreferrer">
          {label} <span aria-hidden="true">↗</span>
        </a>
      ))
    }
  </div>
</article>
