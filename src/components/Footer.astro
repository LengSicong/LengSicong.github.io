---
import { site } from "@/data/site";
---

<footer class="site-footer page-width">
  <p>© {new Date().getUTCFullYear()} {site.name}</p>
  <p>
    Last updated <time datetime={site.lastUpdated}
      >{
        new Date(`${site.lastUpdated}T12:00:00Z`).toLocaleDateString("en-US", {
          month: "long",
          year: "numeric",
          timeZone: "UTC",
        })
      }</time>
  </p>
  <a href="#main">Back to top ↑</a>
</footer>
